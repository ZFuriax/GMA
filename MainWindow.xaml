<!-- MainWindow.xaml -->
<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MusicPlayer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:MusicPlayer"
        Title="Music Player"
        Width="540"
        Height="290"
        MinWidth="540"
        MinHeight="130"
        Background="#111"
        Foreground="#EEE"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

        <!-- Proper custom chrome (prevents the top white resize strip) -->
        <shell:WindowChrome.WindowChrome>
                <shell:WindowChrome CaptionHeight="0"
                                    CornerRadius="0"
                                    GlassFrameThickness="0"
                                    UseAeroCaptionButtons="False"
                                    ResizeBorderThickness="6"/>
        </shell:WindowChrome.WindowChrome>

        <Window.Resources>
                <local:MultiplyConverter x:Key="MultiplyConverter"/>

                <!-- Unified ScrollBar styling (applies to BOTH playlist + waveform) -->
                <Style TargetType="{x:Type ScrollBar}">
                        <Setter Property="Background"
                                Value="#111"/>
                        <Setter Property="Foreground"
                                Value="#666"/>
                        <Setter Property="BorderBrush"
                                Value="#333"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="SnapsToDevicePixels"
                                Value="True"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                <Grid Background="{TemplateBinding Background}">
                                                        <Track x:Name="PART_Track"
                                                               Orientation="{TemplateBinding Orientation}"
                                                               IsDirectionReversed="False"
                                                               Minimum="{TemplateBinding Minimum}"
                                                               Maximum="{TemplateBinding Maximum}"
                                                               Value="{TemplateBinding Value}"
                                                               ViewportSize="{TemplateBinding ViewportSize}">
                                                                <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                                      Opacity="0"
                                                                                      Focusable="False"/>
                                                                </Track.DecreaseRepeatButton>

                                                                <Track.Thumb>
                                                                        <Thumb MinHeight="4"
                                                                               MinWidth="4"
                                                                               Background="#444"
                                                                               BorderBrush="#555"
                                                                               BorderThickness="1">
                                                                                <Thumb.Template>
                                                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                                        CornerRadius="3"/>
                                                                                        </ControlTemplate>
                                                                                </Thumb.Template>
                                                                        </Thumb>
                                                                </Track.Thumb>

                                                                <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                                      Opacity="0"
                                                                                      Focusable="False"/>
                                                                </Track.IncreaseRepeatButton>
                                                        </Track>
                                                </Grid>

                                                <ControlTemplate.Triggers>

                                                        <!-- Hide buttons we aren't using -->
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.35"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- ✅ Dark tooltip theme (fixes tooltip regression) -->
                <Style TargetType="{x:Type ToolTip}">
                        <Setter Property="Background"
                                Value="#1E1E1E"/>
                        <Setter Property="Foreground"
                                Value="#EEE"/>
                        <Setter Property="BorderBrush"
                                Value="#555"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Padding"
                                Value="8,4"/>
                        <Setter Property="Placement"
                                Value="Top"/>
                        <Setter Property="HasDropShadow"
                                Value="True"/>
                </Style>

                <!-- Basic “classic player” look -->
                <Style TargetType="{x:Type Button}">
                        <Setter Property="Padding"
                                Value="8,4"/>
                        <Setter Property="Margin"
                                Value="2,0"/>
                        <Setter Property="Background"
                                Value="#1E1E1E"/>
                        <Setter Property="BorderBrush"
                                Value="#333"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Foreground"
                                Value="#EEE"/>
                        <Setter Property="FontSize"
                                Value="12"/>
                        <Setter Property="SnapsToDevicePixels"
                                Value="True"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#2A2A2A"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="#4A4A4A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#333"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="#666"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.45"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style TargetType="{x:Type ToggleButton}">
                        <Setter Property="Padding"
                                Value="8,4"/>
                        <Setter Property="Margin"
                                Value="2,0"/>
                        <Setter Property="Background"
                                Value="#1E1E1E"/>
                        <Setter Property="BorderBrush"
                                Value="#333"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Foreground"
                                Value="#EEE"/>
                        <Setter Property="FontSize"
                                Value="12"/>
                        <Setter Property="SnapsToDevicePixels"
                                Value="True"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#2A2A2A"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="BorderBrush"
                                                                        Value="#4A4A4A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#2E3B2E"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="BorderBrush"
                                                                        Value="#66AA66"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.45"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Transport buttons -->
                <Style x:Key="TransportButton"
                       TargetType="{x:Type Button}"
                       BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Height"
                                Value="26"/>
                        <Setter Property="MinWidth"
                                Value="38"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="FontFamily"
                                Value="Segoe MDL2 Assets"/>
                </Style>

                <!-- Dark, slim vertical scrollbar -->
                <Style x:Key="PlaylistScrollBarStyle"
                       TargetType="{x:Type ScrollBar}">
                        <Setter Property="Width"
                                Value="8"/>
                        <Setter Property="Background"
                                Value="#111"/>
                        <Setter Property="Foreground"
                                Value="#333"/>
                        <Setter Property="BorderBrush"
                                Value="#111"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                </Style>

                <Style x:Key="PlaylistScrollBarThumbStyle"
                       TargetType="{x:Type Thumb}">
                        <Setter Property="Background"
                                Value="#333"/>
                        <Setter Property="BorderBrush"
                                Value="#333"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#444"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#555"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Playlist ListBox look (smooth + no click-through) -->
                <Style TargetType="{x:Type ListBox}">
                        <Setter Property="Background"
                                Value="#0D0D0D"/>
                        <Setter Property="BorderBrush"
                                Value="#333"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Foreground"
                                Value="#EEE"/>
                        <Setter Property="Padding"
                                Value="6"/>
                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                                Value="Visible"/>
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                                Value="Disabled"/>

                        <!-- ✅ Smooth thumb dragging -->
                        <Setter Property="ScrollViewer.CanContentScroll"
                                Value="False"/>
                        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled"
                                Value="False"/>
                        <Setter Property="ScrollViewer.PanningMode"
                                Value="Both"/>
                        <Setter Property="VirtualizingStackPanel.IsVirtualizing"
                                Value="True"/>
                        <Setter Property="VirtualizingStackPanel.VirtualizationMode"
                                Value="Recycling"/>

                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBox}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        SnapsToDevicePixels="True">
                                                        <ScrollViewer Focusable="False"
                                                                      Padding="{TemplateBinding Padding}"
                                                                      Background="{TemplateBinding Background}"
                                                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">

                                                                <ScrollViewer.Resources>
                                                                        <Style TargetType="{x:Type ScrollBar}">
                                                                                <Setter Property="Width"
                                                                                        Value="8"/>
                                                                                <Setter Property="MinWidth"
                                                                                        Value="8"/>
                                                                                <Setter Property="Background"
                                                                                        Value="#111"/>
                                                                                <Setter Property="Foreground"
                                                                                        Value="#666"/>
                                                                                <Setter Property="BorderBrush"
                                                                                        Value="#333"/>
                                                                                <Setter Property="BorderThickness"
                                                                                        Value="1"/>

                                                                                <Setter Property="Template">
                                                                                        <Setter.Value>
                                                                                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                                                                        <!-- Only customize the vertical bar. Horizontal can stay hidden. -->
                                                                                                        <Grid x:Name="Root"
                                                                                                              Background="{TemplateBinding Background}">
                                                                                                                <Track x:Name="PART_Track"
                                                                                                                       IsDirectionReversed="True"
                                                                                                                       Orientation="{TemplateBinding Orientation}"
                                                                                                                       Minimum="{TemplateBinding Minimum}"
                                                                                                                       Maximum="{TemplateBinding Maximum}"
                                                                                                                       Value="{TemplateBinding Value}"
                                                                                                                       ViewportSize="{TemplateBinding ViewportSize}">
                                                                                                                        <!-- No top/bottom buttons -->
                                                                                                                        <Track.DecreaseRepeatButton>
                                                                                                                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                                                                                              IsTabStop="False"
                                                                                                                                              Opacity="0"
                                                                                                                                              Height="0"
                                                                                                                                              Focusable="False"/>
                                                                                                                        </Track.DecreaseRepeatButton>

                                                                                                                        <!-- Draggable thumb -->
                                                                                                                        <Track.Thumb>
                                                                                                                                <Thumb/>
                                                                                                                        </Track.Thumb>

                                                                                                                        <Track.IncreaseRepeatButton>
                                                                                                                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                                                                                              IsTabStop="False"
                                                                                                                                              Opacity="0"
                                                                                                                                              Height="0"
                                                                                                                                              Focusable="False"/>
                                                                                                                        </Track.IncreaseRepeatButton>
                                                                                                                </Track>
                                                                                                        </Grid>

                                                                                                        <ControlTemplate.Triggers>

                                                                                                                <!-- Vertical scrollbar thickness -->
                                                                                                                <Trigger Property="Orientation"
                                                                                                                         Value="Vertical">
                                                                                                                        <Setter TargetName="Root"
                                                                                                                                Property="Width"
                                                                                                                                Value="6"/>
                                                                                                                        <Setter TargetName="PART_Track"
                                                                                                                                Property="Width"
                                                                                                                                Value="6"/>
                                                                                                                </Trigger>

                                                                                                                <!-- Horizontal scrollbar thickness -->
                                                                                                                <Trigger Property="Orientation"
                                                                                                                         Value="Horizontal">
                                                                                                                        <Setter TargetName="Root"
                                                                                                                                Property="Height"
                                                                                                                                Value="6"/>
                                                                                                                        <Setter TargetName="PART_Track"
                                                                                                                                Property="Height"
                                                                                                                                Value="6"/>
                                                                                                                </Trigger>

                                                                                                        </ControlTemplate.Triggers>
                                                                                                </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                </Setter>
                                                                        </Style>

                                                                        <Style TargetType="{x:Type Thumb}">
                                                                                <Setter Property="Background"
                                                                                        Value="#333"/>
                                                                                <Setter Property="BorderBrush"
                                                                                        Value="#333"/>
                                                                                <Setter Property="BorderThickness"
                                                                                        Value="0"/>
                                                                                <Setter Property="Template">
                                                                                        <Setter.Value>
                                                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                                                        <Border Background="{TemplateBinding Background}"
                                                                                                                CornerRadius="4"/>
                                                                                                        <ControlTemplate.Triggers>
                                                                                                                <Trigger Property="IsMouseOver"
                                                                                                                         Value="True">
                                                                                                                        <Setter Property="Background"
                                                                                                                                Value="#444"/>
                                                                                                                </Trigger>
                                                                                                                <Trigger Property="IsDragging"
                                                                                                                         Value="True">
                                                                                                                        <Setter Property="Background"
                                                                                                                                Value="#555"/>
                                                                                                                </Trigger>
                                                                                                        </ControlTemplate.Triggers>
                                                                                                </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                </Setter>
                                                                        </Style>
                                                                </ScrollViewer.Resources>

                                                                <ItemsPresenter/>
                                                        </ScrollViewer>
                                                </Border>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Padding"
                                Value="6,4"/>
                        <Setter Property="Margin"
                                Value="0,1"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        CornerRadius="6">
                                                        <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#1A1A1A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#2E3B2E"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#FFFFFF"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Tabs: white text on black, 1px separator  -->
                <Style TargetType="{x:Type TabControl}">
                        <Setter Property="Background"
                                Value="#000"/>
                        <Setter Property="BorderBrush"
                                Value="#333"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TabControl}">
                                                <Grid SnapsToDevicePixels="True">
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="1"/>
                                                                <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <TabPanel Grid.Row="0"
                                                                  IsItemsHost="True"
                                                                  Background="#000"
                                                                  Margin="0"
                                                                  KeyboardNavigation.TabIndex="1"/>

                                                        <Border Grid.Row="1"
                                                                Background="#333"
                                                                Height="1"/>

                                                        <Border Grid.Row="2"
                                                                Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                Padding="0">
                                                                <ContentPresenter ContentSource="SelectedContent"
                                                                                  Margin="0"
                                                                                  KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                        </Border>
                                                </Grid>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="PlaylistTabItemStyle"
                       TargetType="{x:Type TabItem}">
                        <Setter Property="Foreground"
                                Value="#FFF"/>
                        <Setter Property="Background"
                                Value="#000"/>
                        <Setter Property="BorderBrush"
                                Value="#333"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Padding"
                                Value="6,2,6,2"/>
                        <Setter Property="Margin"
                                Value="0,0,2,0"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TabItem}">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6,6,0,0"
                                                        Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter ContentSource="Header"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0"/>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#151515"/>
                                                        </Trigger>

                                                        <Trigger Property="IsSelected"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#262626"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="BorderBrush"
                                                                        Value="#666"/>
                                                        </Trigger>

                                                        <!-- Playing playlist -->
                                                        <Trigger Property="Tag"
                                                                 Value="Playing">
                                                                <Setter TargetName="Bd"
                                                                        Property="BorderBrush"
                                                                        Value="#66AA66"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#CFFFCF"/>
                                                        </Trigger>

                                                        <!-- Selected + playing playlist -->
                                                        <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                        <Condition Property="Tag"
                                                                                   Value="Playing"/>
                                                                        <Condition Property="IsSelected"
                                                                                   Value="True"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#162016"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="BorderBrush"
                                                                        Value="#66AA66"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#FFFFFF"/>
                                                        </MultiTrigger>

                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.45"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Small icon button (Segoe MDL2 Assets) for +, minimize, close -->
                <Style x:Key="TitleIconButton"
                       TargetType="{x:Type Button}"
                       BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="FontFamily"
                                Value="Segoe MDL2 Assets"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="MinWidth"
                                Value="28"/>
                        <Setter Property="Height"
                                Value="22"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Margin"
                                Value="4,0,0,0"/>
                </Style>

                <Style x:Key="TitleIconToggleButton"
                       TargetType="{x:Type ToggleButton}"
                       BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="FontFamily"
                                Value="Segoe MDL2 Assets"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="MinWidth"
                                Value="28"/>
                        <Setter Property="Height"
                                Value="22"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Margin"
                                Value="4,0,0,0"/>

                        <Style.Triggers>
                                <Trigger Property="IsChecked"
                                         Value="True">
                                        <Setter Property="Background"
                                                Value="#2E3B2E"/>
                                        <Setter Property="BorderBrush"
                                                Value="#66AA66"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>

                <!-- ✅ Glyph button style -->
                <Style x:Key="GlyphButton"
                       TargetType="{x:Type Button}"
                       BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="FontFamily"
                                Value="Segoe MDL2 Assets"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="Height"
                                Value="26"/>
                        <Setter Property="MinWidth"
                                Value="30"/>
                        <Setter Property="Padding"
                                Value="0"/>
                </Style>

                <Style x:Key="GlyphToggle"
                       TargetType="{x:Type ToggleButton}"
                       BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="FontFamily"
                                Value="Segoe MDL2 Assets"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="Height"
                                Value="26"/>
                        <Setter Property="MinWidth"
                                Value="30"/>
                        <Setter Property="Padding"
                                Value="0"/>
                </Style>

                <Style x:Key="WaveformHorizontalScrollBarStyle"
                       TargetType="{x:Type ScrollBar}">
                        <!-- This controls thickness -->
                        <Setter Property="Height"
                                Value="6"/>
                        <Setter Property="MinHeight"
                                Value="6"/>

                        <Setter Property="Background"
                                Value="#111"/>
                        <Setter Property="BorderBrush"
                                Value="#333"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>

                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                <!-- IMPORTANT: bind the root height to the ScrollBar height -->
                                                <Grid x:Name="Root"
                                                      Height="{TemplateBinding Height}"
                                                      MinHeight="{TemplateBinding MinHeight}"
                                                      Background="{TemplateBinding Background}">

                                                        <Track x:Name="PART_Track"
                                                               Orientation="{TemplateBinding Orientation}"
                                                               IsDirectionReversed="False">

                                                                <!-- hide buttons -->
                                                                <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Opacity="0"
                                                                                      IsTabStop="False"
                                                                                      Focusable="False"/>
                                                                </Track.DecreaseRepeatButton>

                                                                <Track.Thumb>
                                                                        <Thumb MinHeight="4"
                                                                               MinWidth="4"
                                                                               Background="#444"
                                                                               BorderBrush="#555"
                                                                               BorderThickness="1">
                                                                                <Thumb.Template>
                                                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                                        CornerRadius="3"/>
                                                                                        </ControlTemplate>
                                                                                </Thumb.Template>
                                                                        </Thumb>
                                                                </Track.Thumb>

                                                                <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Opacity="0"
                                                                                      IsTabStop="False"
                                                                                      Focusable="False"/>
                                                                </Track.IncreaseRepeatButton>
                                                        </Track>
                                                </Grid>

                                                <!-- Force the track height to match the scrollbar height -->
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="Orientation"
                                                                 Value="Horizontal">
                                                                <Setter TargetName="PART_Track"
                                                                        Property="Height"
                                                                        Value="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                        </Trigger>

                                                        <!-- safety: if vertical ever appears, collapse it -->
                                                        <Trigger Property="Orientation"
                                                                 Value="Vertical">
                                                                <Setter Property="Width"
                                                                        Value="0"/>
                                                                <Setter Property="MinWidth"
                                                                        Value="0"/>
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Playlist column header button: tiny press nudge + custom hover -->
                <Style x:Key="PlaylistHeaderButton"
                       TargetType="{x:Type Button}">
                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Left"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                        <Setter Property="BorderBrush"
                                Value="Transparent"/>

                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="HorizontalAlignment"
                                Value="Left"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Opacity"
                                Value="0.8"/>
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>

                        <Setter Property="RenderTransformOrigin"
                                Value="0.5,0.5"/>
                        <Setter Property="RenderTransform">
                                <Setter.Value>
                                        <TranslateTransform X="0"
                                                            Y="0"/>
                                </Setter.Value>
                        </Setter>

                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                        <ContentPresenter
                                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                Margin="{TemplateBinding Padding}"/>
                                                </Border>

                                                <ControlTemplate.Triggers>

                                                        <!-- Hover -->
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#2A2A2A"/>
                                                        </Trigger>

                                                        <!-- Press nudge -->
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                                <TranslateTransform X="2"
                                                                                                    Y="2"/>
                                                                        </Setter.Value>
                                                                </Setter>
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#333333"/>
                                                        </Trigger>

                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

        </Window.Resources>

        <Border Background="#111"
                BorderBrush="#000"
                BorderThickness="0">
                <Grid Margin="10">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- title bar -->
                                <RowDefinition Height="Auto"/>
                                <!-- waveform -->
                                <RowDefinition Height="Auto"/>
                                <!-- transport -->
                                <RowDefinition Height="Auto"/>
                                <!-- scene strip -->
                                <RowDefinition Height="*"/>
                                <!-- playlist -->
                        </Grid.RowDefinitions>

                        <!-- Custom Title Bar -->
                        <Border Grid.Row="0"
                                Background="#111"
                                BorderBrush="#000"
                                BorderThickness="0"
                                Padding="6,4"
                                MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="GMA"
                                                   FontSize="12"
                                                   Opacity="0.85"
                                                   VerticalAlignment="Center"
                                                   Margin="2,0,10,0"/>

                                        <Button Grid.Column="1"
                                                x:Name="InfoButton"
                                                Click="InfoButton_Click"
                                                Style="{StaticResource TitleIconButton}"
                                                Content=""
                                                ToolTipService.InitialShowDelay="0">
                                                <Button.ToolTip>
                                                        <TextBlock TextAlignment="Center">
							<Run FontWeight="Bold">Game Master Audio</Run>
							<LineBreak/>
							<Run>Version 1.09</Run> <!-- Version Number -->
							<LineBreak/>
							<Run>© Z</Run>
                                                        </TextBlock>
                                                </Button.ToolTip>

                                        </Button>

                                        <ToggleButton Grid.Column="2"
                                                      x:Name="VoiceCaptureToggle"
                                                      Style="{StaticResource TitleIconToggleButton}"
                                                      Content="&#xE720;"
                                                      ToolTip="Voice Capture - Controls voice-trigger listening mode for playlist activation. Off disables listening. On listens continuously. Ctrl listens only while Ctrl is held, with a short grace period after release. Be sure to set your key phrases by clicking the microphone icon in the playlist tab."
                                                      Click="VoiceCaptureToggle_Click"
                                                      Margin="4,0,0,0"/>

                                        <TextBlock Grid.Column="3"
                                                   x:Name="TrackTitleText"
                                                   Text="No track loaded"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="4"
                                                x:Name="CollapseButton"
                                                Style="{StaticResource TitleIconButton}"
                                                Content=""
                                                ToolTip="Collapse playlist"
                                                Click="CollapseButton_Click"/>

                                        <Button Grid.Column="5"
                                                x:Name="MinButton"
                                                Style="{StaticResource TitleIconButton}"
                                                Content=""
                                                ToolTip="Minimize"
                                                Click="MinButton_Click"/>

                                        <Button Grid.Column="6"
                                                x:Name="CloseButton"
                                                Style="{StaticResource TitleIconButton}"
                                                Content=""
                                                ToolTip="Close"
                                                Click="CloseButton_Click"/>
                                </Grid>
                        </Border>

                        <!-- Waveform (wrapped in ScrollViewer for zooming) -->
                        <ScrollViewer Grid.Row="1"
                                      x:Name="WaveformScroller"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      PanningMode="HorizontalOnly">

                                <ScrollViewer.Resources>
                                        <!-- This style ONLY applies to scrollbars inside WaveformScroller -->
                                        <Style TargetType="{x:Type ScrollBar}">
                                                <!-- overall thickness -->
                                                <Setter Property="Height"
                                                        Value="6"/>
                                                <Setter Property="MinHeight"
                                                        Value="6"/>
                                                <Setter Property="Background"
                                                        Value="#111"/>
                                                <Setter Property="BorderBrush"
                                                        Value="#333"/>
                                                <Setter Property="BorderThickness"
                                                        Value="1"/>

                                                <Setter Property="Template">
                                                        <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                                        <Grid x:Name="Root"
                                                                              Height="{TemplateBinding Height}"
                                                                              MinHeight="{TemplateBinding MinHeight}"
                                                                              Background="{TemplateBinding Background}">
                                                                                <Track x:Name="PART_Track"
                                                                                       Orientation="{TemplateBinding Orientation}"
                                                                                       IsDirectionReversed="False"
                                                                                       Minimum="{TemplateBinding Minimum}"
                                                                                       Maximum="{TemplateBinding Maximum}"
                                                                                       Value="{TemplateBinding Value}"
                                                                                       ViewportSize="{TemplateBinding ViewportSize}">

                                                                                        <Track.DecreaseRepeatButton>
                                                                                                <RepeatButton Opacity="0"
                                                                                                              IsTabStop="False"
                                                                                                              Focusable="False"/>
                                                                                        </Track.DecreaseRepeatButton>

                                                                                        <Track.Thumb>
                                                                                                <Thumb MinHeight="4"
                                                                                                       MinWidth="4"
                                                                                                       Background="#444"
                                                                                                       BorderBrush="#555"
                                                                                                       BorderThickness="1">
                                                                                                        <Thumb.Template>
                                                                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                                                                        <Border Background="{TemplateBinding Background}"
                                                                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                                                                CornerRadius="3"/>
                                                                                                                </ControlTemplate>
                                                                                                        </Thumb.Template>
                                                                                                </Thumb>
                                                                                        </Track.Thumb>

                                                                                        <Track.IncreaseRepeatButton>
                                                                                                <RepeatButton Opacity="0"
                                                                                                              IsTabStop="False"
                                                                                                              Focusable="False"/>
                                                                                        </Track.IncreaseRepeatButton>

                                                                                </Track>
                                                                        </Grid>

                                                                        <ControlTemplate.Triggers>
                                                                                <!-- Keep horizontal thin -->
                                                                                <Trigger Property="Orientation"
                                                                                         Value="Horizontal">
                                                                                        <Setter TargetName="PART_Track"
                                                                                                Property="Height"
                                                                                                Value="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                                                </Trigger>

                                                                                <!-- Collapse vertical if it ever appears -->
                                                                                <Trigger Property="Orientation"
                                                                                         Value="Vertical">
                                                                                        <Setter Property="Width"
                                                                                                Value="0"/>
                                                                                        <Setter Property="MinWidth"
                                                                                                Value="0"/>
                                                                                        <Setter Property="Visibility"
                                                                                                Value="Collapsed"/>
                                                                                </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                        </Setter.Value>
                                                </Setter>
                                        </Style>
                                </ScrollViewer.Resources>

                                <Grid Margin="0,0,0,8">
                                        <!-- Visualizer BEHIND the waveform -->
                                        <controls:RainVisualizerOverlay
                                                x:Name="RainOverlay"
                                                Opacity="1"
                                                IsHitTestVisible="False"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Panel.ZIndex="0"/>

                                        <!-- Waveform ON TOP -->
                                        <controls:WaveformProgressBar
                                                x:Name="WaveformBar"
                                                Opacity="0.7"
                                                Height="Auto"
                                                MinHeight="44"
                                                Focusable="True"
                                                Progress="0.0"
                                                LoopEnabled="{Binding IsChecked, ElementName=LoopToggle}"
                                                LoopA="0.0"
                                                LoopB="1.0"
                                                MouseLeftButtonDown="WaveformBar_MouseLeftButtonDown"
                                                MouseMove="WaveformBar_MouseMove"
                                                MouseLeftButtonUp="WaveformBar_MouseLeftButtonUp"
                                                LostMouseCapture="WaveformBar_LostMouseCapture"
                                                PreviewMouseWheel="WaveformBar_PreviewMouseWheel"
                                                Panel.ZIndex="1"
                                                Background="Transparent"
                                                PreviewMouseLeftButtonDown="WaveformBar_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="WaveformBar_PreviewMouseLeftButtonUp"
                                                GotMouseCapture="WaveformBar_GotMouseCapture"/>
                                </Grid>
                        </ScrollViewer>

                        <!-- Transport row -->
                        <Grid Grid.Row="2"
                              Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: original controls moved here, now glyphs -->
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">

                                        <!-- Repeat: keep same name + click handler -->
                                        <Button x:Name="RepeatButton"
                                                Style="{StaticResource GlyphButton}"
                                                Content="&#xE8EE;"
                                                ToolTip="Repeat"
                                                Click="RepeatButton_Click"/>

                                        <!-- Shuffle: keep same name used by code -->
                                        <ToggleButton x:Name="ShuffleToggle"
                                                      Style="{StaticResource GlyphToggle}"
                                                      Content="&#xE14B;"
                                                      ToolTip="Shuffle"/>

                                        <!-- Loop (A–B): NEW glyph candidate (distinct from repeat) -->
                                        <ToggleButton x:Name="LoopToggle"
                                                      Style="{StaticResource GlyphToggle}"
                                                      Content="&#xE8AB;">
                                                <ToggleButton.ToolTip>
                                                        <TextBlock TextAlignment="Left">
                                    <Run FontWeight="Bold">Loop</Run>
                                    <LineBreak/>
                                    <Run>Repeats a selected section of the current track.</Run>
                                    <LineBreak/>
                                    <Run>Set a start point and an end point to continuously loop</Run>
                                    <LineBreak/>
                                    <Run>that portion using the chevrons above the progress bar.</Run>
                                    <LineBreak/>
                                    <Run>Enabling Crossfade while this is active is highly recommended.</Run>
                                                        </TextBlock>
                                                </ToggleButton.ToolTip>
                                        </ToggleButton>

                                        <ToggleButton x:Name="XFadeButton"
                                                      Style="{StaticResource GlyphToggle}"
                                                      Content="&#xE9D9;"
                                                      Checked="XFadeButton_Checked"
                                                      Unchecked="XFadeButton_Unchecked">
                                        </ToggleButton>

                                        <Button x:Name="SceneButton"
                                                Style="{StaticResource GlyphButton}"
                                                Content="&#xE90B;"
                                                Click="SceneButton_Click">

                                                <Button.ToolTip>
                                                        <TextBlock TextAlignment="Left"
                                                                   TextWrapping="Wrap">
                            <Run FontWeight="Bold">Scene Mode</Run>
                            <LineBreak/>
                            <Run>Allows up to four tracks to be layered together to create a scene.</Run>
                            <LineBreak/>
                            <Run>One music track and up to three ambience tracks can be</Run>
                            <LineBreak/>
                            <Run>played simultaneously, each with its own volume slider.</Run>
                            <LineBreak/>
                            <Run>Be sure to tag at least one playlist using the set ambience</Run>
                            <LineBreak/>
                            <Run>playlist button in the playlist's tab.</Run>
                            <LineBreak/>
                            <Run>Songs in that playlist will play in the ambience tracks area.</Run>
                            <LineBreak/>
                            <Run>Automatically loops the ambience tracks.</Run>
                                                        </TextBlock>
                                                </Button.ToolTip>

                                        </Button>
                                </StackPanel>

                                <!-- Centered playback buttons (do not modify playback glyphs) -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Button x:Name="PrevButton"
                                                Style="{StaticResource TransportButton}"
                                                Content="&#xE892;"
                                                ToolTip="Previous"
                                                Click="PrevButton_Click"/>
                                        <Button x:Name="StopButton"
                                                Style="{StaticResource TransportButton}"
                                                Content="&#xE71A;"
                                                ToolTip="Stop"
                                                Click="StopButton_Click"/>

                                        <Button x:Name="PlayPauseButton"
                                                Style="{StaticResource TransportButton}"
                                                FontFamily="Segoe MDL2 Assets"
                                                Content="&#xE768;"
                                                ToolTip="Play/Pause"
                                                Click="PlayPauseButton_Click"/>

                                        <Button x:Name="NextButton"
                                                Style="{StaticResource TransportButton}"
                                                Content="&#xE893;"
                                                ToolTip="Next"
                                                Click="NextButton_Click"/>
                                </StackPanel>

                                <!-- RIGHT: Normalize -> Voice Capture -> Volume -> Track Time -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                        <!-- Normalize: keep same name used by code -->
                                        <ToggleButton x:Name="NormalizeToggle"
                                                      Style="{StaticResource GlyphToggle}"
                                                      Content="&#xE9D2;">

                                                <ToggleButton.ToolTip>
                                                        <TextBlock TextAlignment="Left"
                                                                   TextWrapping="Wrap">
                                <Run FontWeight="Bold">Dynamic Wave Normalization</Run>
                                <LineBreak/>
                                <Run>Balances volume differences within a track so playback stays more consistent.</Run>
                                <LineBreak/>
                                <Run>This helps to prevent the need to continually adjust the volume as a song</Run>
                                <LineBreak/>
                                <Run>becomes louder or softer.</Run>
                                                        </TextBlock>
                                                </ToggleButton.ToolTip>

                                        </ToggleButton>

                                        <Button x:Name="VolumeButton"
                                                PreviewMouseLeftButtonDown="VolumeButton_PreviewMouseLeftButtonDown"
                                                PreviewMouseWheel="VolumeButton_PreviewMouseWheel"
                                                Style="{StaticResource GlyphButton}"
                                                Content="&#xE767;"
                                                ToolTip="Master Volume"
                                                Click="VolumeButton_Click"/>

                                        <Popup x:Name="VolumePopup"
                                               PlacementTarget="{Binding ElementName=VolumeButton}"
                                               Placement="Top"
                                               StaysOpen="False"
                                               AllowsTransparency="True">

                                                <Border Background="#1E1E1E"
                                                        BorderBrush="#555"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10">
                                                        <Slider x:Name="VolumeSlider"
                                                                Minimum="0"
                                                                Maximum="100"
                                                                Value="100"
                                                                Width="140"
                                                                Height="18"
                                                                VerticalAlignment="Center"
                                                                IsMoveToPointEnabled="True"/>
                                                </Border>
                                        </Popup>

                                        <TextBlock x:Name="TimeText"
                                                   Text="00:00 / --:--"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="10,0,0,0"
                                                   FontSize="12"
                                                   Opacity="0.9"/>
                                </StackPanel>
                        </Grid>

                        <!-- Scene strip -->
                        <Border x:Name="SceneStrip"
                                Grid.Row="3"
                                Visibility="Collapsed"
                                Background="#0D0D0D"
                                BorderBrush="#333"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6"
                                Margin="0,0,0,8">
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Lane 1: Music -->
                                        <Grid x:Name="SceneLane1"
                                              Grid.Column="0"
                                              Margin="0,0,4,0"
                                              Background="Black"
                                              Tag="0">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="18"/>
                                                        <RowDefinition Height="22"/>
                                                </Grid.RowDefinitions>

                                                <!-- music slider spans full lane height -->
                                                <Grid Grid.Row="0"
                                                      Grid.RowSpan="2"
                                                      Tag="0"
                                                      Background="Transparent"
                                                      MouseLeftButtonDown="SceneLane_MouseLeftButtonDown"
                                                      MouseMove="SceneLane_MouseMove"
                                                      MouseLeftButtonUp="SceneLane_MouseLeftButtonUp">
                                                        <Border x:Name="SceneFill1"
                                                                HorizontalAlignment="Left"
                                                                Background="#666666"
                                                                Width="0"
                                                                CornerRadius="3"/>
                                                        <TextBlock x:Name="SceneText1"
                                                                   Text="Music Volume"
                                                                   Foreground="#EEEEEE"
                                                                   Margin="8,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsHitTestVisible="False"/>
                                                </Grid>
                                        </Grid>

                                        <!-- Lane 2 -->
                                        <Grid x:Name="SceneLane2"
                                              Grid.Column="1"
                                              Margin="0,0,4,0"
                                              Background="Black"
                                              Tag="1">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="18"/>
                                                        <RowDefinition Height="22"/>
                                                </Grid.RowDefinitions>

                                                <!-- top row: volume slider -->
                                                <Grid Grid.Row="0"
                                                      Tag="1"
                                                      Background="Transparent"
                                                      MouseLeftButtonDown="SceneLane_MouseLeftButtonDown"
                                                      MouseMove="SceneLane_MouseMove"
                                                      MouseLeftButtonUp="SceneLane_MouseLeftButtonUp">
                                                        <Border x:Name="SceneFill2"
                                                                HorizontalAlignment="Left"
                                                                Background="#666666"
                                                                Width="0"
                                                                CornerRadius="3"/>
                                                        <TextBlock x:Name="SceneText2"
                                                                   Text="Empty"
                                                                   Foreground="#EEEEEE"
                                                                   Margin="8,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsHitTestVisible="False"/>
                                                </Grid>

                                                <!-- bottom row: play/pause + close -->
                                                <Grid Grid.Row="1"
                                                      Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button x:Name="ScenePlay2"
                                                                Grid.Column="0"
                                                                Height="20"
                                                                Margin="2,0,4,0"
                                                                Padding="0"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Content="&#xE768;"
                                                                Click="ScenePlay2_Click"/>

                                                        <Button x:Name="SceneClose2"
                                                                Grid.Column="1"
                                                                Width="20"
                                                                Height="20"
                                                                Margin="0,0,2,0"
                                                                Padding="0"
                                                                Content="✕"
                                                                Click="SceneClose2_Click"/>
                                                </Grid>
                                        </Grid>

                                        <!-- Lane 3 -->
                                        <Grid x:Name="SceneLane3"
                                              Grid.Column="2"
                                              Margin="0,0,4,0"
                                              Background="Black"
                                              Tag="2">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="18"/>
                                                        <RowDefinition Height="22"/>
                                                </Grid.RowDefinitions>

                                                <!-- top row: volume slider -->
                                                <Grid Grid.Row="0"
                                                      Tag="2"
                                                      Background="Transparent"
                                                      MouseLeftButtonDown="SceneLane_MouseLeftButtonDown"
                                                      MouseMove="SceneLane_MouseMove"
                                                      MouseLeftButtonUp="SceneLane_MouseLeftButtonUp">
                                                        <Border x:Name="SceneFill3"
                                                                HorizontalAlignment="Left"
                                                                Background="#666666"
                                                                Width="0"
                                                                CornerRadius="3"/>
                                                        <TextBlock x:Name="SceneText3"
                                                                   Text="Empty"
                                                                   Foreground="#EEEEEE"
                                                                   Margin="8,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsHitTestVisible="False"/>
                                                </Grid>

                                                <!-- bottom row: play/pause + close -->
                                                <Grid Grid.Row="1"
                                                      Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button x:Name="ScenePlay3"
                                                                Grid.Column="0"
                                                                Height="20"
                                                                Margin="2,0,4,0"
                                                                Padding="0"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Content="&#xE768;"
                                                                Click="ScenePlay3_Click"/>

                                                        <Button x:Name="SceneClose3"
                                                                Grid.Column="1"
                                                                Width="20"
                                                                Height="20"
                                                                Margin="0,0,2,0"
                                                                Padding="0"
                                                                Content="✕"
                                                                Click="SceneClose3_Click"/>
                                                </Grid>
                                        </Grid>

                                        <!-- Lane 4 -->
                                        <Grid x:Name="SceneLane4"
                                              Grid.Column="3"
                                              Margin="0,0,4,0"
                                              Background="Black"
                                              Tag="3">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="18"/>
                                                        <RowDefinition Height="22"/>
                                                </Grid.RowDefinitions>

                                                <!-- top row: volume slider -->
                                                <Grid Grid.Row="0"
                                                      Tag="3"
                                                      Background="Transparent"
                                                      MouseLeftButtonDown="SceneLane_MouseLeftButtonDown"
                                                      MouseMove="SceneLane_MouseMove"
                                                      MouseLeftButtonUp="SceneLane_MouseLeftButtonUp">
                                                        <Border x:Name="SceneFill4"
                                                                HorizontalAlignment="Left"
                                                                Background="#666666"
                                                                Width="0"
                                                                CornerRadius="3"/>
                                                        <TextBlock x:Name="SceneText4"
                                                                   Text="Empty"
                                                                   Foreground="#EEEEEE"
                                                                   Margin="8,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsHitTestVisible="False"/>
                                                </Grid>

                                                <!-- bottom row: play/pause + close -->
                                                <Grid Grid.Row="1"
                                                      Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button x:Name="ScenePlay4"
                                                                Grid.Column="0"
                                                                Height="20"
                                                                Margin="2,0,4,0"
                                                                Padding="0"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Content="&#xE768;"
                                                                Click="ScenePlay4_Click"/>

                                                        <Button x:Name="SceneClose4"
                                                                Grid.Column="1"
                                                                Width="20"
                                                                Height="20"
                                                                Margin="0,0,2,0"
                                                                Padding="0"
                                                                Content="✕"
                                                                Click="SceneClose4_Click"/>
                                                </Grid>
                                        </Grid>
                                </Grid>
                        </Border>

                        <!-- Playlist -->
                        <Border x:Name="PlaylistSection"
                                Grid.Row="4"
                                Background="#0D0D0D"
                                BorderBrush="#333"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <!-- Column Headers -->
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header row: tabs + "+" button -->
                                        <Grid Grid.Row="0"
                                              Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TabControl x:Name="PlaylistTabs"
                                                            Grid.Column="0"
                                                            Margin="0"
                                                            SelectionChanged="PlaylistTabs_SelectionChanged">
                                                </TabControl>

                                                <Button x:Name="AddPlaylistButton"
                                                        Grid.Column="1"
                                                        Style="{StaticResource TitleIconButton}"
                                                        Content=""
                                                        ToolTip="New playlist"
                                                        Click="AddPlaylistButton_Click"/>
                                        </Grid>

                                        <!-- Column headers (CLICKABLE) -->
                                        <Grid x:Name="PlaylistHeaderGrid"
                                              Grid.Row="1"
                                              Margin="12,0,6,4"
                                              SnapsToDevicePixels="True"
                                              TextOptions.TextFormattingMode="Display"
                                              TextOptions.TextRenderingMode="ClearType">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.5*"
                                                                          MaxWidth="{Binding ElementName=PlaylistHeaderGrid,
                                                    Path=ActualWidth,
                                                    Converter={StaticResource MultiplyConverter},
                                                    ConverterParameter=0.55}"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- File -->
                                                <Button Grid.Column="0"
                                                        Style="{StaticResource PlaylistHeaderButton}"
                                                        Content="Song"
                                                        Click="Header_File_Click"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        FontWeight="SemiBold"
                                                        Opacity="0.8"
                                                        HorizontalAlignment="Left"/>

                                                <!-- Album -->
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource PlaylistHeaderButton}"
                                                        Content="Album"
                                                        Click="Header_Album_Click"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        FontWeight="SemiBold"
                                                        Opacity="0.8"
                                                        HorizontalContentAlignment="Left"/>

                                                <!-- Duration -->
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource PlaylistHeaderButton}"
                                                        Content="Duration"
                                                        Click="Header_Duration_Click"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        FontWeight="SemiBold"
                                                        Opacity="0.8"
                                                        HorizontalAlignment="Right"
                                                        Margin="6,0,0,0"/>
                                        </Grid>

                                        <ListBox x:Name="PlaylistList"
                                                 Grid.Row="2"
                                                 Focusable="True"
                                                 SelectionMode="Extended"
                                                 AllowDrop="True"
                                                 MouseDoubleClick="PlaylistList_MouseDoubleClick"
                                                 SelectionChanged="PlaylistList_SelectionChanged"
                                                 PreviewMouseLeftButtonDown="PlaylistList_PreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="PlaylistList_PreviewMouseMove"
                                                 PreviewMouseRightButtonDown="PlaylistList_PreviewMouseRightButtonDown"
                                                 PreviewKeyDown="PlaylistList_PreviewKeyDown"
                                                 PreviewDragOver="PlaylistList_PreviewDragOver"
                                                 PreviewDrop="PlaylistList_PreviewDrop">

                                                <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <Grid Margin="6,0,6,4"
                                                                      SnapsToDevicePixels="True">
                                                                        <Grid.ColumnDefinitions>
                                                                                <!-- File name: shares space but capped at half -->
                                                                                <ColumnDefinition Width="1.5*"
                                                                                                  MaxWidth="{Binding ElementName=PlaylistHeaderGrid,
                                     Path=ActualWidth,
                                     Converter={StaticResource MultiplyConverter},
                                     ConverterParameter=0.55}"/>

                                                                                <!-- Album -->
                                                                                <ColumnDefinition Width="1*"/>

                                                                                <!-- Duration -->
                                                                                <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- File -->
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding DisplayName}"
                                                                                   TextTrimming="CharacterEllipsis"/>

                                                                        <!-- Album -->
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding AlbumText}"
                                                                                   TextTrimming="CharacterEllipsis"/>

                                                                        <!-- Duration -->
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding DurationText}"
                                                                                   HorizontalAlignment="Right"
                                                                                   Margin="6,0,0,0"/>
                                                                </Grid>
                                                        </DataTemplate>
                                                </ListBox.ItemTemplate>

                                                <ListBox.ContextMenu>
                                                        <ContextMenu>
                                                                <MenuItem Header="Remove"
                                                                          Click="PlaylistRemove_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="Remove All"
                                                                          Click="PlaylistRemoveAll_Click"/>
                                                        </ContextMenu>
                                                </ListBox.ContextMenu>
                                        </ListBox>

                                </Grid>
                        </Border>
                </Grid>
        </Border>
</Window>